# -----------------------------------------------------------------------------
# 1. ARQUIVOS SENSÍVEIS, CHAVES & CREDENCIAIS
# -----------------------------------------------------------------------------
# Variáveis de Ambiente
.env
.env.*
*.env
!.env.example
!.env.template

# ASP.NET Core AppSettings (Contém ConnectionStrings e Chaves de API)
appsettings.json
appsettings.*.json
!appsettings.Example.json
!appsettings.template.json
**/appsettings.json
**/appsettings.*.json
!**/appsettings.Example.json
!**/appsettings.template.json

# User Secrets & Launch Settings locais
secrets.json
**/secrets.json
UserSecrets/
[Ll]aunch[Ss]ettings.json

# Neon CLI & Cloud config
.neon
.neon/

