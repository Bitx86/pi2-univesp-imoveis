# =============================================================================
# ENV CONFIGURATION TEMPLATE
# Copie este arquivo para .env (ou configure suas variáveis de ambiente)
# =============================================================================

# Neon PostgreSQL Database
# Obtenha os dados no painel do Neon (Console > Connection Details)
DATABASE_URL="Host=<NEON_HOST>; Database=neondb; Username=neondb_owner; Password=<YOUR_PASSWORD>; SSL Mode=VerifyFull; Channel Binding=Require;"
DATABASE_URL_UNPOOLED="Host=<NEON_HOST>; Database=neondb; Username=neondb_owner; Password=<YOUR_PASSWORD>; SSL Mode=VerifyFull; Channel Binding=Require;"
DATABASE_URL_POOLED="Host=<NEON_HOST_POOLER>; Database=neondb; Username=neondb_owner; Password=<YOUR_PASSWORD>; SSL Mode=VerifyFull; Channel Binding=Require;"
POSTGRES_URL="postgresql://neondb_owner:<YOUR_PASSWORD>@<NEON_HOST>/neondb?sslmode=require"

# Gecko API (Ingestão de Imóveis)
GECKO_API_BASE_URL="https://api.geckoapi.com.br"
GECKO_API_KEY="<YOUR_GECKO_API_KEY>"

# Frontend Next.js
NEXT_PUBLIC_API_URL="http://localhost:5209"
